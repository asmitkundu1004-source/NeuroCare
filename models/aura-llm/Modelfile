# Aura: Llama-3.2-3B-Instruct, LoRA fine-tuned for empathetic responses (Unsloth),
# merged and quantised to Q4_K_M GGUF.
#
#   Put the .gguf next to this file, then:   ollama create aura -f Modelfile
#
# Sampling here is a neutral default; the server sets temperature and top_p per
# therapeutic stance on every request.

FROM ./aura-empathy-llama-3.2-3b.Q4_K_M.gguf

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""

PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|eom_id|>"
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
